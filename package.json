{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--require ./scripts/win-epipe-fix.js\" next dev -H 0.0.0.0",
    "prebuild": "npm run validate:content",
    "build": "cross-env NODE_OPTIONS=\"--require ./scripts/win-epipe-fix.js\" next build",
    "start": "cross-env NODE_OPTIONS=\"--require ./scripts/win-epipe-fix.js\" next start",
    "lint": "eslint .",
    "test": "npm run lint && vitest run --reporter=verbose",
    "prepare": "husky",
    "ingest": "tsx scripts/ingest.ts",
    "backfill:rag-metadata": "tsx scripts/backfill-rag-metadata.ts",
    "inventory:content": "tsx scripts/content-inventory.ts",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@google/generative-ai": "^0.12.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "ai": "^3.1.26",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.6",
    "glob": "^10.4.1",
    "gray-matter": "^4.0.3",
    "maath": "^0.10.7",
    "motion": "^10.18.0",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intersection-observer": "^9.10.3",
    "remark": "^15.0.1",
    "strip-markdown": "^6.0.0",
    "three": "^0.164.1",
    "three-stdlib": "^2.30.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.164.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "husky": "^9.0.11",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.17.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
